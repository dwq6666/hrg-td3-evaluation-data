// Bundled, deterministic textures: no Gazebo Fuel or user model cache needed.
material Traversability/ArenaGround
{
  technique { pass {
    ambient 0.78 0.78 0.78 1
    diffuse 0.90 0.90 0.90 1
    specular 0.02 0.02 0.02 1 8
    texture_unit { texture ../textures/arena_concrete.png scale 0.18 0.18 }
  } }
}

